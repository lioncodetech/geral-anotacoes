{
  "manifest_version": 3,
  "name": "Geral - anotacoes",
  "version": "1.0.4",
  "description": "Um caderno de anotacoes flutuante em qualquer site. Alt+P mostra e Alt+O esconde; o texto e salvo sozinho.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["teclado.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["anotacoes.js"],
      "run_at": "document_idle"
    }
  ]
}
